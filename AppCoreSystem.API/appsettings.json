{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} [{CorrelationId}]{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": "",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} [{CorrelationId}]{NewLine}{Exception}"

        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName"],
    "Properties": {
      "ApplicationName": "SeqLoggingApi"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=AppCoreSystemDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "AccessTokenSecret": "Mods@wer@321U$#%asd!,@312322LKKKLldMdKL!@##$^",
    "RefreshTokenSecret": "ODldsa;re!@#$%test!key#@$VS%FVE$@!#$!waeqa345",
    "Issuer": "https://localhost:7204/",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "Audience": "https://localhost:4200/",
    "ExpirationInMinutes": 60
  }
}
